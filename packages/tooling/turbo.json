        "$TURBO_ROOT$/.claude/skills/**",
        "$TURBO_ROOT$/.husky/**",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/backlog/**",
        "$TURBO_ROOT$/tracker/docs/**",
        "$TURBO_ROOT$/CURRENT.md",
        "$TURBO_ROOT$/BACKLOG.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/services/bot-client/src/**",
        "$TURBO_ROOT$/services/ai-worker/src/**",
        "$TURBO_ROOT$/services/api-gateway/src/**",
        "$TURBO_ROOT$/tests/e2e/contracts/**",
        "$TURBO_ROOT$/prisma/drift-ignore.json",
        "$TURBO_ROOT$/packages/common-types/src/**"
      ]
