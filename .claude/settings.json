{
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "SYG_DISPATCH_SRC_RE": "^(services|packages)/.+\\.(ts|tsx|js|jsx|mjs|cjs|mts|cts|py)$",
    "SYG_LOSSY_PIPE_GH_WRAPPERS": "gh:pr-all gh:pr-comments gh:pr-conversation gh:pr-info gh:pr-reviews gh:ci-gate"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/skill-eval.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/pr-merge-review-check.sh"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/develop-code-commit-guard.sh"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/board-commit-branch-gate.sh"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/self-matching-pattern-guard.sh"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/cwd-drift-guard.sh"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/python-heredoc-edit-guard.sh"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/pr-body-ref-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/dispatch-spec-ledger-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/pr-monitor-reminder.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "LS(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)",
      "TodoRead",
      "TodoWrite(*)",
      "Batch(*)",
      "Fetch(*)",
      "Search(*)",
      "WebSearch",
      "Skill(*)",
      "Bash",
      "Monitor",
      "AskUserQuestion",
      "mcp__ide__getDiagnostics",
      "mcp__council__*",
      "WebFetch(domain:blog.platformatic.dev)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.bullmq.io)",
      "WebFetch(domain:docs.railway.app)",
      "WebFetch(domain:docs.railway.com)",
      "WebFetch(domain:nixpacks.com)",
      "WebFetch(domain:openrouter.ai)",
      "WebFetch(domain:discord-api-types.dev)"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": false,
  "attribution": {
    "sessionUrl": false
  }
}
