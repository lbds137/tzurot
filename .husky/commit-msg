# Session URLs are secrets (00-critical.md) — block them before they enter
# immutable history (510 historical trailers predate this hook).
if grep -qE 'claude\.ai/code/session_' "$1"; then
    echo "✖ Commit message contains a Claude session URL — these are secrets on a public repo."
    echo "  Remove the claude.ai/code/session_... line (end at Co-Authored-By)."
    exit 1
fi

# The `|| exit 1` is LOAD-BEARING, not defensive. This script has no `set -e`,
# so its exit status is its last command's. It is the last command today, which
# makes the guard look redundant — it is not: append any always-zero step after
# it (the retired rider-checklist banner ended in `|| true`) and a failing
# commitlint falls through, silently disabling message linting.
npx --no -- commitlint --edit "$1" || exit 1
