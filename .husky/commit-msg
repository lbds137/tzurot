# Session URLs are secrets (00-critical.md) — block them before they enter
# immutable history (510 historical trailers predate this hook).
if grep -qE 'claude\.ai/code/session_' "$1"; then
    echo "✖ Commit message contains a Claude session URL — these are secrets on a public repo."
    echo "  Remove the claude.ai/code/session_... line (end at Co-Authored-By)."
    exit 1
fi

# The `|| exit 1` is LOAD-BEARING, not defensive. This script has no `set -e`,
# so its exit status is its last command's — and the fixup-rider call below ends
# in `|| true`, which always yields 0. Drop this and a failing commitlint falls
# through and the commit is accepted, silently disabling message linting.
npx --no -- commitlint --edit "$1" || exit 1

# Advisory: surface the review-response rider checklist when this commit is a
# fixup/squash rider. Reads the message subject (`fixup! …`), which git writes
# only for real riders — exact where the previous command-text match was a
# heuristic. Never blocks; `|| true` keeps a missing/failed script harmless.
.claude/hooks/fixup-rider-check.sh "$1" || true
